# ---- Backend -------------------------------------------------------------
# mock    = runs fully offline (LLM replaced by a deterministic stand-in; everything else real)
# foundry = real Azure AI Foundry Agent Service
TRIAGE_BACKEND=mock

# ---- Azure AI Foundry (only needed for TRIAGE_BACKEND=foundry) ------------
# Foundry portal > your project > Overview > "Azure AI Foundry project endpoint"
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Name of a chat model DEPLOYMENT in that project that supports tool calling
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o-mini
# Prefix for agent names created in Foundry
TRIAGE_AGENT_PREFIX=claims-triage
# Send traces to the project's Application Insights (Foundry portal > Tracing)
TRIAGE_FOUNDRY_TRACING=false

# ---- Behaviour ----------------------------------------------------------
TRIAGE_RUN_TIMEOUT_S=90
TRIAGE_TOOL_MAX_RETRIES=2
# Freeze "today" so date checks are reproducible in demos (leave empty to use the real date)
TRIAGE_TODAY=2026-09-24
# Failure-injection for demos, comma separated:  <tool_name>:<n>  or  agent.<agent_name>:<n>
# e.g. assess_fraud_indicators:1,agent.adjuster_briefing:2
TRIAGE_FAULT_INJECTION=
TRIAGE_LOG_LEVEL=INFO
